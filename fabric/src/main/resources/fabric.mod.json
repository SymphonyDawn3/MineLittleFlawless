{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contributors": [
    "zazlesynth"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_homepage}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.projectflawless.minelittleflawless.fabric.MineLittleFlawlessDataGenerator"
    ],
    "main": [
      "org.projectflawless.minelittleflawless.fabric.MineLittleFlawlessFabric"
    ],
    "client": [
      "org.projectflawless.minelittleflawless.fabric.MineLittleFlawlessFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "fabric-api": "*",
    "smartbrainlib": ">=1.15",
    "geckolib": ">=4.8.4"
  },
  "mixins": [
    "minelittleflawless.fabric.mixins.json",
    "minelittleflawless.mixins.json"
  ]
}
